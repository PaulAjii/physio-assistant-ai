# ─────────────────────────────────────────────────────────────────────────────
# Root environment for the container stack (Postgres + MinIO).
#
#   cp .env.example .env      # then edit .env — never commit .env
#
# Per-service app config lives in backend-core/.env and backend-ai/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
# Owner role: owns the schema and runs migrations. Created by the Postgres image.
POSTGRES_USER=physio
POSTGRES_PASSWORD=change-me-in-local-dev
POSTGRES_DB=physio

# Host port for Postgres. Change if 5432 is already in use locally.
POSTGRES_PORT=5432

# Runtime role: what backend-core connects as. Non-superuser, so Row-Level
# Security is actually enforced against it (superusers and table owners bypass
# RLS silently). Created by infra/postgres/init/01-create-app-role.sh.
APP_DB_USER=physio_app
APP_DB_PASSWORD=change-me-too

# ── MinIO (S3-compatible object storage for audio/video) ────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-as-well

# S3 API port and web console port on the host.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket created automatically on first start.
MINIO_BUCKET=physio-media
