# Server
PORT=8080

# URL of the NestJS AI backend's process-audio endpoint.
# Must match where backend-ai is actually listening (backend-ai/.env sets PORT).
AI_BACKEND_URI=http://localhost:5000/ai/process-audio

# Directory for temporarily saved audio uploads.
UPLOAD_DIR=uploads

# Comma-separated list of allowed CORS origins (use specific origins in production).
CORS_ALLOWED_ORIGINS=*

# Postgres connection string. Required — the app fails fast at startup if unset.
#
# Connect as the RUNTIME role (physio_app / APP_DB_USER), NOT the owner. The
# owner bypasses Row-Level Security, so using it here would silently turn off
# tenant isolation. User/password/port/db must match the root .env of the stack.
DATABASE_URL=postgres://physio_app:change-me-too@localhost:5432/physio?sslmode=disable
